generator client {
  provider = "prisma-client-js"
}

// Migrations take a session-level advisory lock, which a transaction-mode pooler (Neon's
// "-pooler" host) can leave stuck; DIRECT_URL must point at the non-pooled host.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String
  avatarUrl  String?
  provider   String // "google" | "microsoft"
  providerId String
  createdAt  DateTime @default(now())
  classes    Class[]
  exams      Exam[]
}

// Đề thi (tính năng "Tạo đề"). `data` là toàn bộ ExamData của frontend (nội dung đề, ảnh dạng
// data URL, các mã đề); `sizeBytes` = độ dài JSON để hiển thị dung lượng đang dùng.
model Exam {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  sourceName String?
  data       Json
  sizeBytes  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Class {
  id                String          @id @default(uuid())
  name              String
  defaultTuitionFee Decimal         @db.Decimal(12, 0)
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  students          Student[]
  periods           TuitionPeriod[]
  createdAt         DateTime        @default(now())
}

model Student {
  id                String           @id @default(uuid())
  stt               Int?
  fullName          String
  classId           String
  class             Class            @relation(fields: [classId], references: [id])
  parentEmail       String?
  parentPhone       String?
  // Parent's display name on Facebook and/or Zalo; the flags say which of the two it is.
  parentContactName String?
  parentFacebook    Boolean          @default(false)
  parentZalo        Boolean          @default(false)
  // Expected tuition for one period (kỳ học phí).
  monthlyTuitionFee Decimal          @db.Decimal(12, 0)
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now())
  payments          TuitionPayment[]
  reminders         ReminderLog[]
}

// A billing period of one class, e.g. "Tháng 7 (15/6-14/7)". `year`/`month` place it on
// the shared month axis so periods of different classes line up in the grid and dashboard.
// Tuition is due on the period's last day (endDate); a period without an end date is never overdue.
model TuitionPeriod {
  id        String           @id @default(uuid())
  classId   String
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  name      String
  year      Int
  month     Int
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime         @default(now())
  payments  TuitionPayment[]

  @@unique([classId, year, month])
}

// No row for a (student, period) means the student is not enrolled in that period ("—").
model TuitionPayment {
  id             String        @id @default(uuid())
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  periodId       String
  period         TuitionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  expectedAmount Decimal       @db.Decimal(12, 0)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 0)
  isPaid         Boolean       @default(false)
  paidDate       DateTime?
  note           String?
  // Own dates for a student who started at a different time than the class. When set, the
  // due date is customEndDate instead of the period's endDate.
  customStartDate DateTime?
  customEndDate   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  reminders      ReminderLog[]

  @@unique([studentId, periodId])
}

model ReminderLog {
  id           String         @id @default(uuid())
  studentId    String
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentId    String
  payment      TuitionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reminderType String // "due" | "overdue7" | "overdue15"
  sentAt       DateTime       @default(now())

  @@unique([paymentId, reminderType])
}
