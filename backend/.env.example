PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tuition_db
# Non-pooled connection used by prisma migrate (same as DATABASE_URL when not using a pooler).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/tuition_db
SESSION_SECRET=change_me
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

GMAIL_USER=
GMAIL_APP_PASSWORD=


# Comma-separated accounts allowed to sign in; they all share the data of the first one.
# Leave empty to let every account that can sign in have its own separate data.
ALLOWED_EMAILS=

# "Tạo đề từ ảnh" (POST /api/exams/ocr): Gemini API key from Google AI Studio
# (https://aistudio.google.com/apikey). Leave empty to disable the feature (returns 503).
GEMINI_API_KEY=
# Optional, defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash

# Secret for POST /api/cron/reminders (external daily scheduler).
CRON_SECRET=

TZ=Asia/Ho_Chi_Minh
